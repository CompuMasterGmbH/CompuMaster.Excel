<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CompuMaster.Excel</RootNamespace>
    <TargetFrameworks>net48;net6.0</TargetFrameworks>
    <Copyright>2005-2026 CompuMaster GmbH</Copyright>
    <AssemblyName>CompuMaster.Excel.OpenXml</AssemblyName>
    <PackageId>CompuMaster.Excel.OpenXml</PackageId>
    <!-- Set the Open XML release version here. Dated releases use major.minor.YYYY with a revision of MMDD * 10 plus the daily index, starting at 0. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>CompuMaster GmbH</Authors>
    <Description>Edits XLSX templates with the Open XML SDK through the ExcelOps API.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logo_64x64.png</PackageIcon>
    <PackageProjectUrl>https://github.com/CompuMasterGmbH/CompuMaster.Excel/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OptionStrict>On</OptionStrict>
    <RepositoryUrl>https://github.com/CompuMasterGmbH/CompuMaster.Excel.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ExcelNumberFormat" Version="1.1.0" />
    <PackageReference Include="PCRE.NET" Version="1.6.0" />
    <ProjectReference Include="..\ExcelOps\ExcelOps.vbproj" />
    <EmbeddedResource Include="GermanFormulaNames.tsv" LogicalName="CompuMaster.Excel.OpenXml.GermanFormulaNames.tsv" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="..\logo_64x64.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
